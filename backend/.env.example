PORT=4000
NODE_ENV=development

# PostgreSQL connection. Either set DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smarttrack
PGSSL=false

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins (the Vite dev server + deployed frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Base URL of the web console, used in emailed login links
APP_URL=http://localhost:5173/smart-trak

# SMTP — leave blank in dev to skip real sending; emails are still logged to
# email_logs so you can see what would have gone out (view via Email Logs page).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartTrack <no-reply@smarttrack.app>

# Push notifications (mobile) — not wired up yet, sending is stubbed (see
# src/utils/push.js). Set this once a Firebase service account is available.
# FCM_CREDENTIALS_PATH=
